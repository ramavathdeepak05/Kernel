# ALIS Frontend Environment Variables
# Copy to .env.local for development, or set in CI/CD for production builds

# Backend API URL — required for production builds
# Dev: proxied via vite.config.ts, so this can be omitted locally
VITE_API_URL=https://api.alis.app/api

# Default tenant ID for single-tenant deployments
# Omit for multi-tenant (tenant resolved from subdomain or login form)
VITE_TENANT_ID=
