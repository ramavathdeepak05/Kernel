##############################################################################
# ALIS — Environment Configuration Template
# Copy to .env and fill in values. Never commit .env to git.
##############################################################################

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                          # development | staging | production
APP_SECRET_KEY=change-me-in-production-use-32-char-min
APP_DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALIS_DOMAIN=localhost                        # Public hostname (used by Nginx)
ALIS_BOOTSTRAP_SECRET=                       # One-time secret for seeding initial org
ALIS_MASTER_KEY=                             # Tenant crypto master key

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alis_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=20

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# JWT / Auth
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-jwt-secret-32-char-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional RSA keypair (leave blank to use HS256)
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# MFA
# ---------------------------------------------------------------------------
MFA_REQUIRED_ROLES=SUPER_ADMIN,FINANCE_ADMIN
MFA_CHALLENGE_TOKEN_EXPIRE_MINUTES=10

# ---------------------------------------------------------------------------
# MinIO (local object storage / S3-compatible)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=alis-files
MINIO_SECURE=false                           # Set true in production

# ---------------------------------------------------------------------------
# Storage (S3 | AZURE_BLOB | LOCAL)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=LOCAL
STORAGE_BUCKET=alis-documents
STORAGE_REGION=ap-south-1
ALIS_DATA_DIR=data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# ---------------------------------------------------------------------------
# Ollama (local AI — LLM + embeddings)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3
OLLAMA_EXTRACTION_MODEL=qwen2.5:1.5b-instruct-q8_0
OLLAMA_GENERATION_MODEL=qwen2.5:1.5b-instruct-q8_0
OLLAMA_REASONING_MODEL=qwen2.5:1.5b-instruct-q8_0

# ---------------------------------------------------------------------------
# External LLM API (optional — for NVIDIA NIM / OpenAI-compatible endpoints)
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_API_MODEL=meta/llama-3.2-3b-instruct
LLM_API_TEMPERATURE=0.2
LLM_API_MAX_TOKENS=1024

PGVECTOR_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_EXPIRES=3600

# ---------------------------------------------------------------------------
# SMTP (outbound email)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@alis.local
SMTP_FROM_NAME=ALIS Institution
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# SMS — MSG91 (primary) or Twilio
# ---------------------------------------------------------------------------
SMS_PROVIDER=MSG91                           # MSG91 | TWILIO
SMS_API_KEY=
SMS_SENDER_ID=ALIS
SMS_GATEWAY_ENABLED=false
SMS_TIMEOUT_SECONDS=10

MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=ALISUN

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# WhatsApp (Meta Business API)
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Payment Gateways
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=RAZORPAY            # RAZORPAY | PAYU
PAYMENT_GATEWAY_TIMEOUT_SECONDS=30

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# ---------------------------------------------------------------------------
# HashiCorp Vault (secrets management)
# ---------------------------------------------------------------------------
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_TRANSIT_MOUNT=transit
VAULT_KV_MOUNT=secret

# ---------------------------------------------------------------------------
# Integrations — DigiLocker
# ---------------------------------------------------------------------------
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Integrations — NTA Score Import
# ---------------------------------------------------------------------------
NTA_API_KEY=
NTA_BASE_URL=https://api.nta.ac.in/v1
NTA_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Integrations — LMS (Moodle / Canvas)
# ---------------------------------------------------------------------------
LMS_BASE_URL=
LMS_API_TOKEN=
LMS_DEFAULT_COURSE_CATEGORY=1
LMS_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Integrations — Email Provider (Google Workspace / Microsoft 365)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=SMTP                          # SMTP | GOOGLE | MICROSOFT

GOOGLE_ADMIN_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DOMAIN=

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DOMAIN=

# ---------------------------------------------------------------------------
# Integrations — Drillbit (Plagiarism Detection)
# ---------------------------------------------------------------------------
DRILLBIT_API_KEY=
DRILLBIT_BASE_URL=https://api.drillbit.in/v1
DRILLBIT_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Integrations — NIC e-Invoice (GST IRN)
# ---------------------------------------------------------------------------
NIC_EINVOICE_BASE_URL=https://einvoice1.gst.gov.in
NIC_EINVOICE_CLIENT_ID=
NIC_EINVOICE_CLIENT_SECRET=
NIC_EINVOICE_GSTIN=                          # 15-char GSTIN
NIC_EINVOICE_USERNAME=
NIC_EINVOICE_PASSWORD=
NIC_EINVOICE_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Observability — Sentry
# ---------------------------------------------------------------------------
SENTRY_DSN=                                  # Leave blank to disable
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.01

# ---------------------------------------------------------------------------
# Alertmanager (infra/monitoring/alertmanager.yml references these)
# ---------------------------------------------------------------------------
ALERT_SMTP_HOST=localhost:25
ALERT_FROM_EMAIL=alis-alerts@institution.edu.in
ALERT_OPS_EMAIL=ops@institution.edu.in
ALERT_FINANCE_EMAIL=finance@institution.edu.in
ALERT_ADMISSIONS_EMAIL=admissions@institution.edu.in
ALERT_ACADEMICS_EMAIL=academics@institution.edu.in
ALERT_WEBHOOK_URL=http://localhost:9999/alis-alert
ALERT_WEBHOOK_TOKEN=
