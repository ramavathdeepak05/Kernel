# ALIS Environment Configuration
# Copy this to .env and fill in values. NEVER commit .env to git.

# ---- Application ----
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-32-char-string
APP_DEBUG=false
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alis_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=20

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=alis-files
MINIO_SECURE=false

# ---- Ollama (Local AI) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:1.5b-instruct-q8_0
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-random-32-char-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Bootstrap ----
ALIS_BOOTSTRAP_SECRET=
ALIS_MASTER_KEY=

# ---- SMTP (Email) ----
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourinstitution.edu
SMTP_FROM_NAME=Your Institution
SMTP_USE_TLS=true

# ---- SMS ----
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=ALIS

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
